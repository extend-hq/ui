    "next": "16.2.11",
    "next-themes": "0.4.6",
    "nuqs": "^2.8.9",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
